<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- This target is a WidgetKit extension (AlarmKit's Live Activity UI --
	     see AlarmkitWidgetLiveActivity.swift/AlarmkitWidgetBundle.swift),
	     not an Accessory Setup Extension. The previous
	     EXAppExtensionAttributes/EXExtensionPointIdentifier =
	     com.apple.accessory-setup-extension declaration (with placeholder
	     Bluetooth service UUID and "Example Protocol" UTType boilerplate)
	     was Apple's AccessorySetupKit template content, seemingly picked by
	     mistake when this target was created -- it made App Store Connect
	     validation demand the com.apple.developer.accessory-setup-discovery-
	     extension entitlement for a feature this extension never uses.
	     Matches flutter_alarmkit's own example project's AlarmkitWidget
	     Info.plist exactly. -->
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.widgetkit-extension</string>
	</dict>
</dict>
</plist>
